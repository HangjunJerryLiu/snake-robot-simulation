<mujoco model="9motor_octa_sindwinder_assembly">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.001"/>

  <!--
    VISUAL SETTINGS.  Rendering only - no body, joint, mass, geom size or
    contact parameter is touched here, so a run is bit-for-bit what it was
    before.  The robot climbs 3 m up a 4 cm pole, which is a tall thin scene:
    the defaults clip the shadows, wash out the pole against the sky and put
    the near plane far enough out that a close camera cuts into the body.
  -->
  <visual>
    <headlight ambient="0.35 0.36 0.4" diffuse="0.45 0.45 0.45" specular="0.2 0.2 0.2"/>
    <global offwidth="1920" offheight="1080" azimuth="135" elevation="-12"/>
    <!-- znear small enough to sit right next to the robot; shadowclip covers
         the whole 3 m pole so the shadow does not stop halfway up. -->
    <map znear="0.004" zfar="40" shadowclip="4" shadowscale="0.6" force="0.008"/>
    <quality shadowsize="4096" offsamples="8" numslices="48"/>
    <!-- Haze fades the far floor into the skybox instead of ending it on a
         hard line at the edge of the plane. -->
    <rgba haze="0.55 0.62 0.72 1"/>
    <scale contactwidth="0.03" contactheight="0.012" forcewidth="0.012"
           framelength="0.08" framewidth="0.006" jointlength="0.05"
           jointwidth="0.006"/>
  </visual>
  <default>
  <!--  High friction in ALL directions for pipe gripping (condim=4 = elliptic cone)  -->
  <!--
    CONTACT MATERIAL.  friction = "sliding torsional rolling".
    Only the surface properties are changed here - every body, mesh, mass,
    joint and geometry in this file is exactly as authored.

    sliding 2.0      Assumes high-grip elastomer pads (soft silicone) on the
                     modules.  Measured: at bare-plastic friction (1.0) this
                     robot cannot climb at all; it grips the pole but makes
                     no net height.  The previous value, 4.0, is beyond any
                     real material pair and was doing the climbing by itself:
                     dropping it to 1.0 alone left the robot on the floor.
    torsional 0.02   Resistance to spinning about the contact normal, in
                     metres.  It is roughly (patch radius), so 0.02 is a
                     1-2 cm patch - reasonable for a soft pad pressed onto a
                     pole.  The previous 0.3 implies a 30 cm patch and was,
                     on its own, holding the robot up.
    margin 0.001     1 mm.  Kept from the original, and defensible as pad
                     compliance: the pads really do deform by about that
                     much under the measured contact forces.
  -->
  <geom condim="4" friction="2.0 0.02 0.0001" margin="0.001" solimp="0.95 0.99 0.001" solref="0.01 1"/>
  </default>

  <asset>
    <!-- Sky. Purely so the scene has a horizon to read height against. -->
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.35 0.47 0.66" rgb2="0.78 0.84 0.90" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="512" height="512"/>
    <material name="grid_material" texture="grid" texrepeat="10 10" texuniform="true" reflectance="0"/>
    <!-- Pipe material: brown, slightly shiny -->
    <material name="pipe_material" rgba="0.55 0.27 0.07 1" reflectance="0.3"/>
    <mesh name="tail" content_type="model/stl" file="tail.STL"/>
    <mesh name="M1" content_type="model/stl" file="M1.STL"/>
    <mesh name="L1" content_type="model/stl" file="L1.STL"/>
    <mesh name="M2" content_type="model/stl" file="M2.STL"/>
    <mesh name="L2" content_type="model/stl" file="L2.STL"/>
    <mesh name="M3" content_type="model/stl" file="M3.STL"/>
    <mesh name="L3" content_type="model/stl" file="L3.STL"/>
    <mesh name="M4" content_type="model/stl" file="M4.STL"/>
    <mesh name="L4" content_type="model/stl" file="L4.STL"/>
    <mesh name="M5" content_type="model/stl" file="M5.STL"/>
    <mesh name="L5" content_type="model/stl" file="L5.STL"/>
    <mesh name="M6" content_type="model/stl" file="M6.STL"/>
    <mesh name="L6" content_type="model/stl" file="L6.STL"/>
    <mesh name="M7" content_type="model/stl" file="M7.STL"/>
    <mesh name="L7" content_type="model/stl" file="L7.STL"/>
    <mesh name="M8" content_type="model/stl" file="M8.STL"/>
    <mesh name="L8" content_type="model/stl" file="L8.STL"/>
    <mesh name="M9" content_type="model/stl" file="M9.STL"/>
    <mesh name="head" content_type="model/stl" file="head.STL"/>
  </asset>

  <worldbody>
    <!--
      Three lights rather than one: a key light that casts the shadow, a fill
      from the opposite side so the shaded half of the pole is not black, and
      a high light so the wrap still reads when the robot is 3 m up and the
      camera is looking slightly down at it.
    -->
    <light name="key" directional="true" castshadow="true"
           pos="2 2 4" dir="-0.5 -0.5 -1" diffuse="0.55 0.55 0.52" specular="0.25 0.25 0.25"/>
    <light name="fill" directional="true" castshadow="false"
           pos="-3 -1 3" dir="0.7 0.3 -1" diffuse="0.22 0.24 0.28"/>
    <light name="top" directional="true" castshadow="false"
           pos="0 0 6" dir="0 0 -1" diffuse="0.18 0.18 0.18"/>

    <!--  Floor  -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_material" condim="3" friction="0.9 0.005 0.0001"/>

    <!--
      PIPE: vertical cylinder along the Z-axis.
        size="radius half_height" → radius=0.04 m, total height=3.0 m
        pos="0 0 1.5"             → center at z=1.5 so the pipe runs from z=0 to z=3.0

      TUNING:
        - Increase radius (e.g. 0.06) if the robot body is too thick to wrap tightly.
        - Increase half_height (e.g. 2.5) for a taller pipe.
        - friction="X Y Z": X=sliding, Y=torsional, Z=rolling.
          High X (3.0+) is critical so the robot can push off the pipe surface.
        - condim="4" enables the elliptic friction cone, which handles
          oblique contact forces much better than condim=3 for cylindrical surfaces.
    -->
    <geom name="pipe" type="cylinder"
          size="0.04 1.5"
          pos="0 0 1.5"
          material="pipe_material"
          condim="4"
          friction="2.0 0.02 0.0001"
          solimp="0.95 0.99 0.001"
          solref="0.01 1"/>

